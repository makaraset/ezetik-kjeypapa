# Copy to .env on the API host and fill in. .env is gitignored — never commit it.
#
# The nine variables in the first two blocks have NO default in
# application.properties. Any one of them missing and the application does not
# start — it fails during bean creation with a placeholder-resolution error,
# which is loud but not obvious if you have not seen it before.

# --- database (separate server, no Docker) -------------------------- REQUIRED
DB_HOST=10.32.2.33
DB_PORT=5432
DB_NAME=kjey_papa_db
DB_USERNAME=
DB_PASSWORD=

# --- application secrets -------------------------------------------- REQUIRED
# Signing key for our own JWTs. Generate a fresh one per environment:
#   openssl rand -base64 48
# Changing it invalidates every issued token, which logs everyone out.
JWT_SECRET_KEY=

# SMTP, used for password-reset and admin notifications.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# SBF core-banking gateway (OCR, CIF lookup, balances). Same Tricube host as LOS.
# SBF_BASIC_AUTH_BASE64 is the base64 of "client_id:client_secret" for the
# OAuth token call — not the user password.
SBF_USERNAME=
SBF_PASSWORD=
SBF_BASIC_AUTH_BASE64=

# --- LOS endpoints --------------------------------------- optional, have defaults
# Leave empty to fall back to the values committed in application.properties.
LOS_TOKEN_ENDPOINT=
LOS_URL_API=
LOS_USERNAME=
LOS_PASSWORD=

# --- Firebase ------------------------------------------- optional, has a default
# Defaults to the copy inside the jar, which is the .example placeholder and
# will not send anything. Point it at the mounted real file:
FIREBASE_CREDENTIALS_PATH=file:/app/firebase-service-account.json

# --- inbound webhook authentication (see PDL_Our_Webhook_Endpoints_for_LOS) ---
# Turn on once Sambat confirm their source addresses and mechanism.
PDL_WEBHOOK_AUTH_ENABLED=false
PDL_WEBHOOK_ALLOWED_IPS=
PDL_WEBHOOK_SECRET=

# --- schema management ---
# `none` while F14 is open: our Note entity says Double where SBF's column is
# numeric(38,2), so `validate` refuses to start and `update` would convert live
# money to floating point. Set to `validate` once that entity is fixed.
DDL_AUTO=none

# --- network exposure ---
# 127.0.0.1 keeps the API on the host only (reach it via an SSH tunnel).
# 0.0.0.0 exposes it to anything that can route to this machine — fine on a
# private UAT network for Swagger and testing, never once internet-facing.
BIND_ADDR=127.0.0.1

# --- behind a TLS-terminating proxy ---
# Without these the application believes every request arrived over plain HTTP,
# because nothing reads X-Forwarded-Proto. Swagger then advertises an http://
# base URL, and "Try it out" on an https:// page is blocked as mixed content —
# the page loads perfectly, and nothing you test actually runs.
#
# `native` is Tomcat's RemoteIpValve, which honours the headers ONLY when the
# peer matches internal-proxies below. Do NOT use `framework`: Spring's
# ForwardedHeaderFilter takes the LEFT-most X-Forwarded-For entry, which any
# caller can forge, and it would also rewrite remoteAddr out from under
# ClientAddress.
#
# internal-proxies is a REGEX (unlike TRUSTED_PROXIES, which is an exact list).
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.32\.6\.(80|81)

# --- reverse proxy ---
# The address(es) the proxy's connections ACTUALLY ARRIVE FROM — comma
# separated, matched by exact string, not by CIDR.
#
# Use the connecting node address, NOT the address the hostname resolves to.
# On SBF UAT those differ: kjeypapa-uat.sambatfinance.com.kh resolves to the
# LB VIP 10.32.6.80, but connections come from the node at 10.32.6.81. Setting
# only .80 silently attributes every request to the load balancer — consents
# record it instead of the customer, and the OCR rate limiter throttles all
# customers against one shared bucket.
#
# Confirm with a packet capture rather than DNS if you are unsure:
#   docker run --rm --net container:kjeypapa-api alpine sh -c \
#     'apk add -q tcpdump; tcpdump -i any -nn -A tcp port 8080'
TRUSTED_PROXIES=10.32.6.80,10.32.6.81
