# Copy to .env on the API host and fill in. .env is gitignored — never commit it.

# --- database (separate server, no Docker) ---
DB_HOST=10.32.2.33
DB_PORT=5432
DB_NAME=kjey_papa_db
DB_USERNAME=
DB_PASSWORD=

# --- Sambat / SBF gateway ---
# The OAuth credentials for the Tricube host. Same host serves LOS and core banking.
SBF_CLIENT_ID=
SBF_CLIENT_SECRET=

# --- inbound webhook authentication (see PDL_Our_Webhook_Endpoints_for_LOS) ---
# Turn this on once Sambat confirm their source addresses and mechanism.
PDL_WEBHOOK_AUTH_ENABLED=false
PDL_WEBHOOK_ALLOWED_IPS=
PDL_WEBHOOK_SECRET=

# --- reverse proxy ---
# The address of the proxy in front of this container. Leave empty ONLY if the
# container is reached directly; otherwise every consent records the proxy's IP.
TRUSTED_PROXIES=
