            "type": "string"
          },
          "verificationStatus": {
            "type": "string"
          },
          "disbursementTxnId": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "verificationDate": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "LosSharedSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-LOS-Signature",
        "description": "Shared secret, sent to you separately. Required on every call; missing or wrong answers HTTP 401 UNAUTHORIZED."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "BAD_REQUEST: the body could not be read, or names no application. The message says which.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageString"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "UNAUTHORIZED: X-LOS-Signature missing or wrong. Nothing was processed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageString"
            }
          }
        }
      },
      "Forbidden": {
        "description": "FORBIDDEN: only once your addresses are allowlisted; the call came from another address.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageString"
            }
          }
        }
      },
      "ServerError": {
        "description": "INTERNAL_SERVER_ERROR: failed on our side. Retry later; re-delivery is safe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageString"
            }
          }
        }
      },
      "Unavailable": {
        "description": "SERVICE_UNAVAILABLE: our authentication is misconfigured. Nothing was processed. Retry later, and tell us.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageString"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "LosSharedSecret": []
    }
  ]
}
