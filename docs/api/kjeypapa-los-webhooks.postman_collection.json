{
  "info": {
    "name": "Kjey PAPA — LOS inbound webhooks",
    "description": "The seven endpoints Sambat LOS calls on Kjey PAPA.\n\n`base` is set to our UAT host. **Set the `secret` variable** to the shared secret we send you separately: every request sends it in X-LOS-Signature, and without it the answer is HTTP 401. Every body here is a working example — each was sent against our UAT and accepted.\n\nTimestamps must be full ISO-8601 instants; a bare date is rejected with HTTP 400 naming the field.\n\n**appId 999999 is a deliberate placeholder that matches no application.** Every request will answer NOT_FOUND until you replace it with the AppId from your own submit response — which is intentional, so running the collection as-is cannot alter a real loan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "https://kjeypapa-uat.sambatfinance.com.kh"
    },
    {
      "key": "secret",
      "value": "",
      "description": "The shared secret we send you separately. Never commit it."
    }
  ],
  "item": [
    {
      "name": "approved",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-LOS-Signature",
            "value": "{{secret}}"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/pdl/los/approved",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "pdl",
            "los",
            "approved"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appId\": 999999,\n  \"losApplicationNo\": \"257861\",\n  \"loanRefNo\": \"PDL-2026-0042\",\n  \"statusCode\": \"A-APPROVED\",\n  \"message\": \"Approved\",\n  \"loanFormRef\": \"form-999999.pdf\",\n  \"loanContractFileRef\": \"contract-999999.pdf\",\n  \"repaymentScheduleRef\": \"schedule-999999.pdf\",\n  \"loanDocRef\": \"docs-999999.zip\",\n  \"settlementAccountNo\": \"1122334\",\n  \"currency\": \"USD\",\n  \"tenor\": 1,\n  \"outstandingAmount\": 50.0,\n  \"repaymentAmount\": 50.0,\n  \"interestAmount\": 0.37,\n  \"interestRatePercent\": 1.5,\n  \"processingFee\": 3.0,\n  \"cbcEnquiryFee\": 1.0,\n  \"netDisbursedAmount\": 45.63,\n  \"loanPeriodDays\": 15,\n  \"schedule\": [\n    {\n      \"installmentNo\": 1,\n      \"dueDate\": \"2026-09-21T00:00:00Z\",\n      \"principalDue\": 49.63,\n      \"interestDue\": 0.37,\n      \"feeDue\": 0.0,\n      \"otherDue\": 0.0,\n      \"totalDue\": 50.0\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "See PDL_Our_Webhook_Endpoints_for_LOS.docx §6"
      }
    },
